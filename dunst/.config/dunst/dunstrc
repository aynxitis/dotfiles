[global]
    follow   = mouse
    width    = (280, 400)
    height   = (0, 300)
    origin   = top-right
    offset   = (12, 40)
    gap_size = 8

    padding            = 14
    horizontal_padding = 14
    frame_width  = 1
    frame_color  = "#2C2C2E"
    corner_radius = 10

    font   = Inter 10
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes

    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    icon_position = left

    mouse_left_click   = close_current
    mouse_middle_click = do_action
    mouse_right_click  = close_all

[urgency_low]
    background = "#1C1C1E"
    foreground = "#98989D"
    timeout    = 5

[urgency_normal]
    background = "#1C1C1E"
    foreground = "#E5E5E7"
    timeout    = 8

[urgency_critical]
    background  = "#1C1C1E"
    foreground  = "#FF453A"
    frame_color = "#FF453A"
    timeout     = 0
