#!/usr/bin/env bash
# Pick an entry from cliphist and put it back on the clipboard.
# Bound to SUPER+V in Hyprland. Wayland only.

selected=$(cliphist list | rofi -dmenu -i -p "Clipboard" \
    -display-columns 2 \
    -theme ~/.config/rofi/clipboard.rasi) || exit 0

[[ -n "$selected" ]] || exit 0
printf '%s\n' "$selected" | cliphist decode | wl-copy
