# Sourced by next-wallpaper and wallpaper-menu.
# Wallpapers live in ~/Pictures/Wallpapers alongside the hyprlock avatar and
# lock background, which are skipped.

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
STATE_FILE="$HOME/.cache/awww-wallpaper-index"

list_wallpapers() {
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        ! -iname 'avatar.*' ! -iname 'lock-*' -print0 | sort -z
}

set_wallpaper() {
    awww img "$1" --transition-type fade --transition-duration 1 --transition-fps 60
}
