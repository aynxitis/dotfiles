{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 8,
    "modules-left": [
        "custom/launcher",
        "wlr/taskbar"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "group/status",
        "custom/power",
        "clock"
    ],
    "custom/launcher": {
        "format": "Apps",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "persistent-workspaces": {
            "*": 5
        },
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "network",
            "battery"
        ]
    },
    "pulseaudio": {
        "format": "{icon}{volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "headphone": "     ",
            "default": [
                "  ",
                "   ",
                "    "
            ]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}: {volume}%"
    },
    "network": {
        "format-wifi": "    {essid}",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "   offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\nclick to pick a network",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "no connection",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },
    "battery": {
        "bat": "BAT0",
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}{capacity}%",
        "format-charging": "    {capacity}%",
        "format-plugged": "{icon}{capacity}%",
        "format-icons": [
            "  ",
            "  ",
            "  ",
            "  ",
            "  "
        ],
        "tooltip-format": "{timeTo}"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 5",
        "tooltip": false
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
