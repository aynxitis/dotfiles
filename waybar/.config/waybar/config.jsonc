// Adapted from RafikW19's My-Dotfiles (dark pills). Their omarchy-* click
// actions are replaced with local tools; unused module definitions dropped.
{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,

    "modules-left": [
        "group/left1"
    ],
    "modules-center": [
        "custom/logo",
        "hyprland/workspaces"
    ],
    "modules-right": [
        "group/right3",
        "group/right4"
    ],

    "group/left1": {
        "orientation": "inherit",
        "modules": [
            "clock"
        ]
    },
    "group/right3": {
        "orientation": "inherit",
        "modules": [
            "network",
            "image#volume",
            "custom/volume-watch",
            "battery"
        ]
    },
    "group/right4": {
        "orientation": "inherit",
        "modules": [
            "custom/power"
        ]
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "cursor": true,
        "format": "{icon}",
        "persistent-workspaces": {
            "*": 5
        }
    },
    "custom/logo": {
        "format": "󰣇",
        "tooltip-format": "Click for fastfetch",
        "on-click": "kitty sh -c 'fastfetch; exec bash'"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%A %d/%m/%Y}",
        "tooltip-format": "<span>{calendar}</span>"
    },
    "network": {
        "format": "{icon} {essid}",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰀂 Ethernet",
        "format-disconnected": "󰤮 Disconnected",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": ["󰀂"],
            "default": ["󰤨"]
        },
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⬇ {bandwidthDownBytes}  ⬆ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n⬇ {bandwidthDownBytes}  ⬆ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 2,
        "spacing": 1,
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },
    "image#volume": {
        "exec": "~/.config/waybar/scripts/volume-ring.sh",
        "size": 22,
        "signal": 8,
        "interval": 30,
        "tooltip": true,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "custom/volume-watch": {
        "exec": "~/.config/waybar/scripts/volume-watch.sh",
        "tooltip": false
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}",
        "format-plugged": "",
        "format-full": "󰂅",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "wlogout -b 5"
    }
}
