* {
  base:      #1C1C1E;
  elevated:  #2C2C2E;
  line:      #3A3A3C;
  label:     #E5E5E7;
  secondary: #98989D;
  accent:    #4A6E85;

  background-color: transparent;
  text-color: @label;
  font: "Inter 11";
}

window {
  width: 480px;
  background-color: @base;
  border: 1px;
  border-color: @line;
  border-radius: 12px;
  padding: 0;
}

inputbar {
  padding: 14px 16px;
  spacing: 10px;
  children: [ prompt, entry ];
  border: 0 0 1px 0;
  border-color: @line;
}

prompt { text-color: @accent; }
entry {
  placeholder: "Search";
  placeholder-color: @secondary;
}

listview {
  lines: 8;
  padding: 6px;
  scrollbar: false;
}

element {
  padding: 8px 10px;
  border-radius: 8px;
  spacing: 10px;
}
element selected {
  background-color: @accent;
  text-color: @label;
}
element-icon { size: 20px; }
element-text { vertical-align: 0.5; }
